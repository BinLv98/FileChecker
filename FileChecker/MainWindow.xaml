<!--
    主窗口界面定义（FileChecker V1.1）。

    布局结构（自上而下五行 Grid）：
      行 0：预留空白
      行 1：拖放区域（支持文件/文件夹拖入，点击等价于"添加文件"）
      行 2：功能按钮区（添加/移除/清空/重扫/去除网络标记/计算哈希/递归勾选/线程数）
      行 3：文件列表区（ListView + GridView 五列：路径、标记、进度、SHA256、MD5）
      行 4：进度区域（摘要文本、进度条、语言选择、取消按钮）

    说明：
      - 界面文案的初始值为中文，运行时由 MainWindow.xaml.cs 的 ApplyLanguage()
        按当前语言覆盖，支持中英文实时切换。
      - 样式资源（PrimaryBtn / NeutralBtn / ListViewItem / RoundProgress）
        定义于本窗口的 Window.Resources 中。
-->
<Window x:Class="FileChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileChecker"
        mc:Ignorable="d"
        Title="FileChecker V1.1" Height="800" Width="1280" MinHeight="540" MinWidth="1040"
        AllowDrop="True" Background="#EEF2F7" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Foreground="#1F2937" WindowStartupLocation="CenterScreen" 
        Closing="Window_Closing" 
        DragLeave="Window_DragLeave"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题色：主按钮/进度条使用的品牌蓝 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2E6BE6" />
            <!-- 分隔线/边框色 -->
            <SolidColorBrush x:Key="LineBrush" Color="#DDE3EC" />
            <!-- 主按钮样式：蓝底白字圆角，带悬停/按下/禁用三态 -->
            <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="Background" Value="#2E6BE6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="bd" Background="{TemplateBinding Control.Background}" CornerRadius="6">
                                <ContentPresenter Name="cp" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 悬停：变亮 -->
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Border.Background" Value="#4A85F2" />
                                </Trigger>
                                <!-- 按下：变深 -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Border.Background" Value="#1E56C4" />
                                </Trigger>
                                <!-- 禁用：灰底半透明 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Border.Background" Value="#C9D2E4" />
                                    <Setter TargetName="cp" Property="UIElement.Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 中性按钮样式：白底描边圆角，用于次级操作 -->
            <Style x:Key="NeutralBtn" TargetType="{x:Type Button}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Foreground" Value="#374151" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="6" BorderBrush="{StaticResource LineBrush}">
                                <ContentPresenter Name="cp" Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 悬停：浅蓝底加深边框 -->
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Border.Background" Value="#F2F5FB" />
                                    <Setter TargetName="bd" Property="Border.BorderBrush" Value="#B9C6DC" />
                                </Trigger>
                                <!-- 按下：更浅的蓝底 -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Border.Background" Value="#E4EAF5" />
                                </Trigger>
                                <!-- 禁用：半透明 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 列表项全局样式：内边距、悬停/选中背景、绑定悬停提示 -->
            <Style x:Key="{x:Type ListViewItem}" TargetType="{x:Type ListViewItem}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FrameworkElement.ToolTip" Value="{Binding Tooltip}" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Style.Triggers>
                    <!-- 悬停行：浅蓝 -->
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F1F5FE" />
                    </Trigger>
                    <!-- 选中行：更深蓝 -->
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter Property="Background" Value="#DDE9FE" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 圆角进度条样式：圆角轨道 + 圆角指示条 -->
            <Style x:Key="RoundProgress" TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="8" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="#E1E7F0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid Name="TemplateRoot">
                                <!-- 轨道（背景） -->
                                <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="4" />
                                <!-- 指示条（前景，按进度横向填充） -->
                                <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" CornerRadius="4" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 第一行 -->
        <Grid Row="0" />

        <!-- 第二行, 拖拽区域 -->
        <Border Name="DropBorder" Grid.Row="1" Height="96" Margin="0,14,0,0" 
                Background="#F0F6FF" BorderBrush="#9DC0FA" BorderThickness="1.5" 
                CornerRadius="10" Cursor="Hand" 
                MouseLeftButtonUp="DropBorder_MouseLeftButtonUp">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="DropTitle" HorizontalAlignment="Center" 
                           FontSize="17" FontWeight="SemiBold" 
                           Foreground="{StaticResource AccentBrush}" 
                           Text="将文件或文件夹拖放到这里" />
                <TextBlock Name="DropSub" Margin="0,6,0,0" HorizontalAlignment="Center" 
                           FontSize="12.5" Foreground="#5A6B85" 
                           Text="文件夹会被递归处理（可在下方取消勾选“包含子文件夹”）" />
            </StackPanel>
        </Border>

        <!-- 第三行, 功能区域 -->
        <Grid Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <!--添加文件-->
                <Button Name="AddFilesBtn" Content="添加文件…" 
                        Style="{StaticResource NeutralBtn}" 
                        Click="AddFiles_Click" />

                <!--添加文件夹-->
                <Button Name="AddFolderBtn" Margin="8,0,0,0" Content="添加文件夹…" 
                        Style="{StaticResource NeutralBtn}" 
                        Click="AddFolder_Click" />

                <!--移除选中-->
                <Button Name="RemoveBtn" Margin="8,0,0,0" Content="移除选中" 
                        Style="{StaticResource NeutralBtn}" Visibility="Collapsed" 
                        Click="RemoveSelected_Click" />

                <!--清空列表-->
                <Button Name="ClearBtn" Margin="8,0,0,0" Content="清空列表" 
                        Style="{StaticResource NeutralBtn}" 
                        Click="ClearList_Click" />

                <!--重新读取文件标记-->
                <Button Name="RescanBtn" Margin="8,0,0,0" Content="重新读取文件标记" 
                        Style="{StaticResource NeutralBtn}" 
                        Click="Rescan_Click" />

                <!--去除网络标记-->
                <Button Name="RemoveMarkBtn" Margin="8,0,0,0" Content="去除网络标记" 
                        Style="{StaticResource PrimaryBtn}" 
                        ToolTip="移除列表中所有文件带有的下载来源标记（如“来自网络”），解除打开文件时的“安全警告”" 
                        Click="RemoveMarkBtn_Click" />

                <!--计算Hash值-->
                <Button Name="HashBtn" Margin="8,0,0,0" Content="计算 SHA256 / MD5" 
                        Style="{StaticResource PrimaryBtn}" 
                        Click="HashBtn_Click" />

                <!--包含子文件夹-->
                <CheckBox Name="RecursiveCheck" Margin="18,0,0,0" VerticalAlignment="Center" Content="包含子文件夹" IsChecked="True" />

                <!--线程数-->
                <TextBlock Name="ThreadsLabel" Margin="18,0,6,0" VerticalAlignment="Center" Foreground="#475467" Text="计算线程数" />
                <ComboBox Name="HashThreadCombo" Width="64" Height="30" 
                          VerticalAlignment="Center" VerticalContentAlignment="Center" 
                          ToolTip="计算 SHA256 / MD5 时同时处理的文件数（1～10，默认为 5）" />
            </StackPanel>
        </Grid>

        <!-- 第四行, 文件列表区域 -->
        <Grid Row="3" Margin="0,12,0,0">
            <Border Background="#FFFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ListView Name="FileList" Margin="2" Background="#00FFFFFF" BorderThickness="0" 
                              Cursor="" KeyboardNavigation.TabNavigation="Once" 
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                              SelectionMode="Extended" 
                              VirtualizingStackPanel.IsVirtualizing="True" 
                              VirtualizingStackPanel.VirtualizationMode="Standard" 
                              MouseDoubleClick="FileList_MouseDoubleClick" 
                              PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown">
                        <FrameworkElement.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="去除选中项的网络标记" Click="RemoveMarkSelected_Click" />
                                <MenuItem Header="查看文件标记详情" Click="ShowDetail_Click" />
                                <MenuItem Header="重新读取文件标记" Click="Rescan_Click" />
                                <Separator />
                                <MenuItem Header="打开所在目录" Click="OpenFolder_Click" />
                                <MenuItem Header="复制完整路径" Click="CopyPath_Click" />
                                <Separator />
                                <MenuItem Header="复制 SHA256" Tag="sha256" Click="CopyHash_Click" />
                                <MenuItem Header="复制 MD5" Tag="md5" Click="CopyHash_Click" />
                                <MenuItem Header="复制 SHA256 和 MD5" Tag="both" Click="CopyHash_Click" />
                                <Separator />
                                <MenuItem Header="移除选中项" Click="RemoveSelected_Click" />
                                <MenuItem Header="清空列表" Click="ClearList_Click" />
                            </ContextMenu>
                        </FrameworkElement.ContextMenu>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="6,7" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <!--文件路径列-->
                                <GridViewColumn Width="350" Header="文件路径">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontSize="12.5" 
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" 
                                                       Text="{Binding Path}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--文件标记列-->
                                <GridViewColumn Width="90" Header="文件标记">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" 
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" 
                                                       Foreground="{Binding AdsForeground}" Text="{Binding AdsText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--进度列-->
                                <GridViewColumn Width="100" Header="进度">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Name="ActiveProgress" HorizontalAlignment="Left" 
                                                            Orientation="Horizontal" Visibility="Collapsed">
                                                    <ProgressBar Width="88" Height="7" Margin="0,0,6,0" 
                                                                 Maximum="100" Minimum="0" 
                                                                 Style="{StaticResource RoundProgress}" 
                                                                 Value="{Binding HashPercent, Mode=OneWay}" />
                                                    <TextBlock VerticalAlignment="Center" FontSize="11.5" 
                                                               FontWeight="SemiBold" Foreground="#2E6BE6" 
                                                               Text="{Binding HashPercentText}" />
                                                </StackPanel>
                                                <TextBlock Name="IdleMark" VerticalAlignment="Center" 
                                                           Foreground="#98A2B3" Text="—" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="Computing" Binding="{Binding HashStage}">
                                                    <Setter TargetName="ActiveProgress" Property="UIElement.Visibility" Value="Visible" />
                                                    <Setter TargetName="IdleMark" Property="UIElement.Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--SHA256-->
                                <GridViewColumn Width="430" Header="SHA256">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" 
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis" 
                                                       TextWrapping="Wrap" Foreground="{Binding Sha256Foreground}" 
                                                       Text="{Binding Sha256}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--MD5-->
                                <GridViewColumn Width="240" Header="MD5">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" 
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       Foreground="{Binding Md5Foreground}" 
                                                       Text="{Binding Md5}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Name="EmptyHint" HorizontalAlignment="Center" 
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Name="EmptyTitle" HorizontalAlignment="Center" 
                                   FontSize="15" Foreground="#98A2B3" 
                                   Text="列表为空" />
                        <TextBlock Name="EmptySub" Margin="0,6,0,0" HorizontalAlignment="Center" 
                                   FontSize="12.5" Foreground="#B0BAC9" 
                                   Text="点击“添加文件 / 添加文件夹”，或将文件、文件夹拖放到上方区域" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 第五行, 进度区域 -->
        <Grid Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--第一列, 进度-->
            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Name="SummaryText" FontWeight="SemiBold" Foreground="#475467" Text="" TextTrimming="CharacterEllipsis" />

                <!--计算进度-->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Name="Progress" Grid.Column="0" VerticalAlignment="Center" 
                                 Maximum="100" Minimum="0" 
                                 Style="{StaticResource RoundProgress}" />
                    <TextBlock Name="CountText" Grid.Column="1" Margin="12,0,0,0" 
                               VerticalAlignment="Center" Foreground="#667085" 
                               Text="0 / 0" />
                </Grid>
            </StackPanel>

            <!--第二列, 语言选择和取消按钮-->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Name="LangLabel" Margin="0,0,6,0" VerticalAlignment="Center" 
                           Foreground="#475467" Text="界面语言" />
                <ComboBox Name="LangCombo" Width="96" Height="30" Margin="0,0,14,0" 
                          VerticalAlignment="Center" VerticalContentAlignment="Center" 
                          SelectionChanged="LangCombo_SelectionChanged" />
                <Button Name="CancelBtn" Content="取消" IsEnabled="False" 
                        Style="{StaticResource NeutralBtn}" 
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
